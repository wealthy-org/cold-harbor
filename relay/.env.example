# Neon connection string. Use the DIRECT (non-pooled) URL: the relay is one long-lived process and migrations need a session.
DATABASE_URL=
# Robinhood Chain testnet
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Railway injects PORT
PORT=8080
# Comma-separated origins allowed to call the REST API (the Vercel web app)
ALLOWED_ORIGINS=http://localhost:3005

# Contracts and tokens (from contracts/deployments/*.json). TOKENS and FW_FEEDS are JSON maps ticker -> address.
SETTLEMENT=
USDG=
FW_ENGINE=
FW_VAULT=
FW_CALENDAR=
TOKENS={}
FW_FEEDS={}

# RFQ rules (defaults shown)
# QUOTE_DEADLINE_MS=1500
# MIN_EXPIRY_SEC=20
# MAX_EXPIRY_SEC=60
# MAX_DEV_BPS_SPOT=150
# MAX_DEV_BPS_FORWARD=1200
# RFQ_PER_MIN_PER_IP=20
