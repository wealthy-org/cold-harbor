# Copy to .env.local. NEXT_PUBLIC_* values are visible in the browser. Never put keys in them.
# Network: 46630 = Robinhood Chain testnet, 4663 = mainnet, 31337 = local anvil.
NEXT_PUBLIC_CHAIN_ID=46630
# Optional. Defaults to the public RPC for the chain. Do not put a keyed provider URL here.
# NEXT_PUBLIC_RPC_URL=
# Deployed addresses (see contracts/deployments/rh-testnet.json)
NEXT_PUBLIC_SETTLEMENT=
NEXT_PUBLIC_USDG=
NEXT_PUBLIC_FEE_BPS=8
# JSON map ticker -> stock token address on THIS network. On mainnet read from the official Robinhood registry.
NEXT_PUBLIC_TOKENS='{}'

# Development only. Simulated market makers (never enabled on chain 4663).
NEXT_PUBLIC_SIM_QUOTES=0
SIM_QUOTES=0
# SERVER-ONLY throwaway testnet keys, comma separated. Never real funds.
SIM_MAKER_PKS=

# Forward stack (from contracts/deployments/rh-testnet-forwards.json). Leave empty to keep Forwards a preview.
NEXT_PUBLIC_FW_ENGINE=
NEXT_PUBLIC_FW_VAULT=
NEXT_PUBLIC_FW_ORACLE=
NEXT_PUBLIC_FW_CALENDAR=
NEXT_PUBLIC_FW_FROM_BLOCK=
NEXT_PUBLIC_FW_FEEDS=

# Relay (Railway). Not used by the UI yet. Public URL only, never put DATABASE_URL in the web app.
NEXT_PUBLIC_RELAY_URL=
